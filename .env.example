# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=  # Optional: for local/compatible APIs (e.g., http://localhost:11434/v1)
LLM_TIMEOUT=15

# Pipeline Settings
SCORING_THRESHOLD=0.75
LOG_LEVEL=INFO

# NOTE: Copy to .env and never commit to version control